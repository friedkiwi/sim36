do @HERE@/test/advanced36-nolisten.sim
attach disk0 @VOLUME@ overlay
ipl pause
trace disk

# SVC 40 command A2 with modifier 80: DATA FIELD WRAP. NuDiskIo::executeInternal
# tests the modifier for exactly 0x80 (c1864f38) and copies the SAME 256 bytes
# from the guest buffer into every sector of the transfer (c1864f7c..c1864ff0);
# SA21-9243-4 figure 6-4 part 6 bit 0. Only one sector of guest storage is read.
#
# Buffer at real 2000: a signature in the first 8 bytes. The NEXT 256 bytes at
# 2100 carry a different signature; with wrap they must NOT reach the disk.
poke 2000 D7 C1 E3 E3 C5 D9 D5 F1
poke 2100 D5 D6 E3 40 E3 C8 C9 E2
# IOB at 1A00: eyecatcher IF, A2/80, buffer 002000, count-1 = 3 (4 sectors),
# 1-based sector 0AAE61 = 700001 (0-based 700000), far above every SSP extent.
poke 1A00 C9 C6 00 00 00 00 00 00 00 00 A2 80 00 00 20 00 00 00 03 0A AE 61
# LA XR1,$1A00 ; SVC 40
poke 1000 C2 A1 1A 00 F4 00 40
set iar 1000
step 2
dump 1A00 24
diskread 700000 4
dump 20000 8
dump 20100 8
dump 20200 8
dump 20300 8
quit
