# SIM/36 default machine, expressed in the monitor command language.
# Paths are relative to this command file, not to the caller's working
# directory.
#
# Only what differs from the emulator's built-in defaults appears here;
# `show config` prints the machine as actually configured.  Already the
# default, and therefore absent: model advanced36, ipl-type unattend,
# ipl-source disk, host-model 150 / feature 2270 / model 440,
# task-work-area-sectors 60, listener-auto-signon off, signon-use-router on,
# signon-statement off, signon-request off, signon-router-key 14,
# ws-interactive off, station role display, device-code 11, listen host
# 127.0.0.1, signon-at-ipl off, terminal multiplex on, and memory 1024K.

# The volume is not distributed with SIM/36: put a System/36 volume image at
# var/as36.img (next to etc/), or change the path below.
#
# Attached `overlay`: writes are accepted into memory and never reach the
# file.  SSP genuinely writes to its volume during IPL (the work station
# configuration table is rewritten, for one), so a read-write attach makes the
# volume a mutable output of every run.  Use `rw` deliberately, on a private
# copy, when writes are wanted.
attach disk0 ../var/as36.img overlay

# Work-station address 0.0 is the console on every 5250 machine, must be
# present for the IPL to complete, and binds to this emulator's operator
# interface rather than to a listener (see `console` in the monitor).
# The six displays are reached through the station multiplexer on
# 127.0.0.1:2300 by default; the per-station listeners below are used when
# `set terminal multiplex off` is given.
set station 0.0 role console
set station 0.1 listen 127.0.0.1:2301
set station 0.2 listen 127.0.0.1:2302
set station 0.3 listen 127.0.0.1:2303
set station 0.4 listen 127.0.0.1:2304
set station 0.5 listen 127.0.0.1:2305
set station 0.6 listen 127.0.0.1:2306
